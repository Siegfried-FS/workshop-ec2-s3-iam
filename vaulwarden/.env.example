# ─────────────────────────────────────────────────────────────────────────────
# 🔑 ARCHIVO DE CONFIGURACIÓN Y SECRETOS: .env.example
# Copia este archivo como '.env' y completa con tus datos reales:
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# 🌐 DOMINIO Y PUERTOS
# Reemplaza con tu dominio o subdominio registrado en Amazon Route 53
DOMAIN=https://vault.tudominio.com
PORT=80
HTTPS_PORT=443

# 📧 CONFIGURACIÓN DE CORREO SALIENTE (Zoho Mail)
# Necesario para enviar invitaciones, códigos 2FA y notificaciones de Vaultwarden
ZOHO_EMAIL=tu_correo@midominio.com
ZOHO_PASSWORD=tu_clave_de_aplicacion_zoho

# SMTP Details para Vaultwarden (Generados automáticamente desde Zoho)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=tu_correo@midominio.com
SMTP_USERNAME=tu_correo@midominio.com

# 🔐 SEGURIDAD Y PANEL DE ADMINISTRACIÓN
# Token de acceso para el panel /admin de Vaultwarden
# Para generar un Token seguro en terminal ejecuta: openssl rand -base64 48
ADMIN_TOKEN=tu_token_super_secreto_aqui

# Control de registros (true para permitir que tus alumnos se registren durante la clase, false para cerrar)
SIGNUPS_ALLOWED=true
WEBSOCKET_ENABLED=true
INVITATIONS_ALLOWED=true

# ☁️ CONFIGURACIÓN DE INFRAESTRUCTURA AWS (Opcional)
AWS_REGION=us-east-1
EC2_INSTANCE_TYPE=t2.micro
SECURITY_GROUP_NAME=sg-vaultwarden-demo
